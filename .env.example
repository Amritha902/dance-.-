# Export these in your shell, or copy to .env (git-ignored) and run:  node --env-file=.env server/index.js  (Node 20.6+). All are optional.

# Turns on the AI coach and Claude's Trend Scout picks.
ANTHROPIC_API_KEY=

# Free YouTube Data API v3 key: Trend Scout reads trends through the official API.
YOUTUBE_API_KEY=

# Compliance mode is the default. "on" opts in to YouTube link downloads and keyless search via yt-dlp.
MIMIC_YTDLP=

# "offline" forces the rule-based coach and picker.
MIMIC_COACH=

PORT=4173
